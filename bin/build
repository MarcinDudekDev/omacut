#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BUILD_DIR="$ROOT/build"

if command -v qmake6 >/dev/null 2>&1; then
  QMAKE=qmake6
elif command -v qmake >/dev/null 2>&1; then
  QMAKE=qmake
# Homebrew links qmake into its own bin, but a login shell that predates
# `brew install qt` won't have picked it up yet.
elif command -v brew >/dev/null 2>&1 && [ -x "$(brew --prefix qt 2>/dev/null)/bin/qmake6" ]; then
  QMAKE="$(brew --prefix qt)/bin/qmake6"
else
  echo "qmake6 or qmake is required to build omacut." >&2
  echo "On macOS: brew install qt ffmpeg" >&2
  exit 1
fi

if command -v nproc >/dev/null 2>&1; then
  JOBS="$(nproc)"
elif command -v sysctl >/dev/null 2>&1; then
  JOBS="$(sysctl -n hw.ncpu 2>/dev/null || echo 1)"
else
  JOBS=1
fi

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

"$QMAKE" "$ROOT/omacut.pro"
make -j"$JOBS"

# macOS builds an .app bundle, not a bare binary — say where it actually is.
if [ -d "$BUILD_DIR/omacut.app" ]; then
  echo "Built $BUILD_DIR/omacut.app"
  echo "Run it with: open $BUILD_DIR/omacut.app"
else
  echo "Built $BUILD_DIR/omacut"
fi
